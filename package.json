{
  "name": "@charismaticalli/skate",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:app": "pnpm --filter @charismaticalli/skate-app dev",
    "dev:budgerigar": "pnpm --filter @charismaticalli/budgerigar dev",
    "fmt": "pnpm fmt:app && pnpm fmt:cli && pnpm fmt:inflow && pnpm fmt:objects && pnpm fmt:backend && pnpm fmt:budgerigar",
    "fmt:app": "pnpm --filter @charismaticalli/skate-app fmt",
    "fmt:budgerigar": "pnpm --filter @charismaticalli/budgerigar fmt",
    "fmt:cli": "pnpm --filter @charismaticalli/skate-cli fmt",
    "fmt:inflow": "pnpm --filter @charismaticalli/skate-inflow fmt",
    "fmt:objects": "pnpm --filter @charismaticalli/skate-objects fmt",
    "fmt:backend": "deno fmt supabase/functions/skate-api",
    "lint": "pnpm lint:app && pnpm lint:cli && pnpm lint:inflow && pnpm lint:objects && pnpm lint:backend && pnpm lint:budgerigar",
    "lint:app": "pnpm --filter @charismaticalli/skate-app lint",
    "lint:budgerigar": "pnpm --filter @charismaticalli/budgerigar lint",
    "lint:cli": "pnpm --filter @charismaticalli/skate-cli lint",
    "lint:inflow": "pnpm --filter @charismaticalli/skate-inflow lint",
    "lint:objects": "pnpm --filter @charismaticalli/skate-objects lint",
    "lint:backend": "deno lint supabase/functions/skate-api",
    "test": "pnpm test:app && pnpm test:inflow && pnpm test:backend",
    "test:app": "pnpm --filter @charismaticalli/skate-app test",
    "test:inflow": "pnpm --filter @charismaticalli/skate-inflow test",
    "test:contract:inflow": "pnpm --filter @charismaticalli/skate-inflow test:contract",
    "test:backend": "deno test --allow-env --config supabase/functions/skate-api/deno.json supabase/functions/skate-api/tests",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:cli && pnpm typecheck:inflow && pnpm typecheck:objects && pnpm typecheck:backend && pnpm typecheck:budgerigar",
    "typecheck:app": "pnpm --filter @charismaticalli/skate-app typecheck",
    "typecheck:budgerigar": "pnpm --filter @charismaticalli/budgerigar typecheck",
    "typecheck:cli": "pnpm --filter @charismaticalli/skate-cli typecheck",
    "typecheck:inflow": "pnpm --filter @charismaticalli/skate-inflow typecheck",
    "typecheck:objects": "pnpm --filter @charismaticalli/skate-objects typecheck",
    "typecheck:backend": "deno check --config supabase/functions/skate-api/deno.json supabase/functions/skate-api/index.ts"
  },
  "packageManager": "pnpm@11.27.1+sha512.a81d4c21b9b09a4b0aebf90ef5e527d4262bdda322d26082978cb549023ac6d9cafc98b19fffaa5c71db438a65f70224edb78d7311187861ff96480d1cdca23c",
  "devDependencies": {
    "@foldkit/devtools-mcp": "^0.20.0",
    "supabase": "2.118.0-beta.52"
  }
}
